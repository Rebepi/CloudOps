# Configuración local. Las credenciales PostgreSQL son exclusivas del laboratorio.
POSTGRES_USER=cloudops
POSTGRES_PASSWORD=cloudops_local
POSTGRES_DB=cloudops
DATABASE_URL=postgresql+asyncpg://cloudops:cloudops_local@localhost:5432/cloudops
APP_ENV=local
AUTH_MODE=mock
FLOCI_ENDPOINT_URL=http://localhost:4566
FLOCI_ACCOUNT_ID=000000000000
FLOCI_REGION=us-east-1
ALLOW_AWS=false
AWS_ACCOUNT_ALLOWLIST=[]
AWS_REGION_ALLOWLIST=["us-east-1"]
# Para compose.aws.yaml: perfil temporal configurado en el host, sin claves en este archivo.
# AWS_PROFILE=cloudops-readonly
# AWS_SHARED_CONFIG_DIR=C:/Users/tu-usuario/.aws
RUN_AWS_SMOKE_TESTS=false
TEST_DATABASE_URL=postgresql+asyncpg://cloudops:cloudops_local@localhost:5432/cloudops_test
