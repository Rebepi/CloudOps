# Copiar a backend/.env. Sustituir los campos REPLACE antes de iniciar la API.
# La contraseña debe coincidir con POSTGRES_PASSWORD del .env de la raíz.
DATABASE_URL=postgresql://cloudops:REPLACE_WITH_A_LOCAL_PASSWORD@127.0.0.1:5433/cloudops
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Perfil local que obtiene una sesión temporal de auditoría.
AWS_PROFILE=cloudops-audit
AWS_REGION=us-east-1
AWS_ROLE_ARN=
AWS_EXTERNAL_ID=
AWS_ROLE_SESSION_NAME=cloudops-audit
AWS_ALLOW_ROOT_AUDIT=false
PORT=27902

# Preparar primero las imágenes: node --import tsx scripts/prepare-security-tools.ts
# Estas opciones reproducen los analizadores habilitados en el entorno validado.
CLOUDOPS_TRIVY_ENABLED=true
CLOUDOPS_TRIVY_PATH=trivy
CLOUDOPS_TRIVY_MODE=docker
CLOUDOPS_SAST_ENABLED=true
CLOUDOPS_SAST_MODE=docker
CLOUDOPS_SAST_PATH=semgrep
CLOUDOPS_GITLEAKS_ENABLED=true
CLOUDOPS_GITLEAKS_MODE=docker
CLOUDOPS_GITLEAKS_PATH=gitleaks
CLOUDOPS_IAC_ENABLED=true

# IA opcional. Completar localmente; nunca publicar la clave del proveedor.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Integraciones opcionales; vacías cuando no se usan.
CLOUDOPS_REPOSITORY_TOKEN=
SECURITY_ALERT_WEBHOOK=
INTERNAL_SSO_SECRET=
NEXUS_BACKEND_URL=http://127.0.0.1:21401
# ADMIN_EMAIL=admin@example.com
